    "entity.LivingEntityMixin",
    "entity.attribute.EntityAttributesMixin",
    "entity.damage.DamageSourcesMixin",
    "entity.effect.StatusEffectMixin",
    "entity.player.PlayerEntityMixin",
    "server.network.ServerPlayerEntityMixin",
    "spell_engine.api.spell.SpellActiveCastMixin",
    "spell_engine.api.spell.SpellCostMixin",
    "spell_engine.api.spell.SpellImpactActionDamageMixin",
    "spell_engine.api.spell.SpellImpactActionHealMixin",
    "spell_engine.api.spell.SpellLaunchPropertiesMixin",
    "spell_engine.api.spell.SpellModifierMixin",
    "spell_engine.api.spell.SpellProjectileDataPerksMixin",
    "spell_engine.api.spell.container.SpellContainerHelperMixin",
    "spell_engine.internals.SpellParametersMixin",
    "spell_engine.internals.arrow.ArrowHelperMixin",
